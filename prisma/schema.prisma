generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Snapshot {
  id          Int              @id @default(autoincrement())
  month       Int
  year        Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assets      Asset[]
  liabilities Liability[]
  income      Income[]
  expenses    Expense[]
  netWorth    Float?
  cashFlow    Float?
  savingsRate Float?

  @@unique([year, month])
}

model Asset {
  id                  Int       @id @default(autoincrement())
  snapshotId          Int
  snapshot            Snapshot  @relation(fields: [snapshotId], references: [id])
  assetId             Int?
  name                String
  category            String
  value               Float
  growthRate          Float?
  monthlyContribution Float?
  riskLevel           Int?     @default(2)  // 1-5 scale
  notes               String?
}

model Liability {
  id              Int       @id @default(autoincrement())
  snapshotId      Int
  snapshot        Snapshot  @relation(fields: [snapshotId], references: [id])
  liabilityId     Int?
  name            String
  category        String
  balance         Float
  interestRate    Float?
  monthlyPayment  Float?
  termMonths      Int?
  isPriority      Boolean?  @default(false)
  notes           String?
}

model Goal {
  id          Int       @id @default(autoincrement())
  name        String
  type        String    // netWorth, saving, debtReduction, custom
  target      Float
  deadline    DateTime
  startDate   DateTime  @default(now())
  currentValue Float?
  isCompleted Boolean   @default(false)
  priority    Int       @default(2)  // 1-3 scale
  notes       String?
  milestones  Milestone[]
}

model Milestone {
  id          Int       @id @default(autoincrement())
  goalId      Int
  goal        Goal      @relation(fields: [goalId], references: [id])
  target      Float
  deadline    DateTime
  isCompleted Boolean   @default(false)
  notes       String?
}

model Budget {
  id          Int       @id @default(autoincrement())
  month       Int
  year        Int
  category    String
  planned     Float
  actual      Float?
  notes       String?
  expenses    Expense[]

  @@unique([year, month, category])
}

model Income {
  id          Int       @id @default(autoincrement())
  snapshotId  Int
  snapshot    Snapshot  @relation(fields: [snapshotId], references: [id])
  source      String
  amount      Float
  isRecurring Boolean   @default(false)
  frequency   String?   // monthly, quarterly, annual
  notes       String?
}

model Expense {
  id          Int       @id @default(autoincrement())
  snapshotId  Int
  snapshot    Snapshot  @relation(fields: [snapshotId], references: [id])
  budgetId    Int?
  budget      Budget?   @relation(fields: [budgetId], references: [id])
  category    String
  amount      Float
  date        DateTime  @default(now())
  isRecurring Boolean   @default(false)
  frequency   String?   // monthly, quarterly, annual
  notes       String?
}

model RiskProfile {
  id              Int     @id @default(autoincrement())
  month           Int
  year            Int
  riskTolerance   Int     // 1-5 scale
  targetStocks    Float?  // Target percentage in stocks
  targetBonds     Float?  // Target percentage in bonds
  targetCash      Float?  // Target percentage in cash
  targetRealEstate Float? // Target percentage in real estate
  targetOther     Float?  // Target percentage in other
  notes           String?

  @@unique([year, month])
}
